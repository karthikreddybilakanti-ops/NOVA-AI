# ============================================================
# NOVA AI — Environment Configuration Template
# ============================================================
# Copy this file to .env or configure in Vercel Project Settings.
# Never commit real API keys or sensitive passwords to GitHub.

# ------------------------------------------------------------
# 1. Server & Deployment
# ------------------------------------------------------------
PORT=3001
NODE_ENV=production

# ------------------------------------------------------------
# 2. Administrator Credentials (for setup and reset)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@nova.ai
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# 3. AI Providers (Server-side Groq & Vision Providers)
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Vision Provider for Images / Screenshots (Optional if only text/documents used)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.6-flash
OPENAI_API_KEY=

# ------------------------------------------------------------
# 4. Supabase Integration (Optional — database & storage sync)
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nova-attachments

# ------------------------------------------------------------
# 5. Client Remote API Base (Optional — only if client is hosted separately)
# ------------------------------------------------------------
VITE_API_URL=
